# Lokalne emulatory Firebase — bez prawdziwego projektu i bez kluczy.
# 1) npm run emulators   2) npm run dev:emu
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-daily-things.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-daily-things
VITE_FIREBASE_APP_ID=demo-app
VITE_USE_EMULATORS=true
