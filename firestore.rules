rules_version = '2';

// Reguły bezpieczeństwa Firestore dla Daily Things.
// Dane prywatne (users/**) widzi i zmienia WYŁĄCZNIE właściciel (również gość).
// Funkcje społecznościowe (profiles, friendCodes, friendships) są dostępne
// tylko dla kont nieanonimowych, a profil czytają jedynie zaakceptowani znajomi.
// Wdrożenie: `npx firebase-tools deploy --only firestore:rules`
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Goście (konta anonimowe) nie biorą udziału w funkcjach społecznościowych
    function isMember() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Id znajomości = posortowane UID połączone '_' (jeden dokument na parę)
    function pairIdOf(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function friendshipPath(a, b) {
      return /databases/$(database)/documents/friendships/$(pairIdOf(a, b));
    }

    function isAcceptedFriend(uid) {
      let path = friendshipPath(request.auth.uid, uid);
      return isMember() && request.auth.uid != uid
        && exists(path) && get(path).data.status == 'accepted';
    }

    // Podgląd osoby (imię + awatar) w zaproszeniu i w kodzie znajomego
    function validPerson(p) {
      return p is map && p.keys().hasOnly(['name', 'avatar'])
        && p.name is string && p.name.size() > 0 && p.name.size() <= 40
        && p.avatar is map && p.avatar.size() <= 12;
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && (!('todos' in request.resource.data) || request.resource.data.todos.size() <= 2000)
        && (!('dailyGoals' in request.resource.data) || request.resource.data.dailyGoals.size() <= 200)
        && (!('cycles' in request.resource.data)
          || (request.resource.data.cycles is list && request.resource.data.cycles.size() <= 200));

      // Jeden dokument na dzień: users/{uid}/habbits/YYYY-MM-DD
      match /habbits/{dateKey} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && dateKey.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.date == dateKey
          && request.resource.data.habbits is list
          && request.resource.data.habbits.size() <= 500
          // Nastrój dnia: liczba 1–5 (opcjonalny)
          && (!('mood' in request.resource.data)
            || (request.resource.data.mood is int
              && request.resource.data.mood >= 1 && request.resource.data.mood <= 5));
      }

      // Jeden dokument na zadanie: users/{uid}/todos/{todoId}
      match /todos/{todoId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.id == todoId
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (!('subtasks' in request.resource.data)
            || (request.resource.data.subtasks is list && request.resource.data.subtasks.size() <= 200));
      }
    }

    // ------------------------------------------------------------------
    // Profil widoczny dla znajomych (imię, awatar, statystyki)
    // ------------------------------------------------------------------
    match /profiles/{uid} {
      allow get: if isOwner(uid) || isAcceptedFriend(uid);
      allow list: if false;
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && isMember()
        && request.resource.data.keys().hasOnly(
          ['displayName', 'avatar', 'friendCode', 'sharing', 'stats', 'todayHabits', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.avatar is map
        && request.resource.data.avatar.size() <= 12
        && request.resource.data.friendCode is string
        && request.resource.data.friendCode.size() <= 12
        && request.resource.data.sharing is map
        // stats / todayHabits są opcjonalne (bez znajomych nie publikujemy statystyk)
        && (request.resource.data.get('stats', null) == null
          || (request.resource.data.stats is map
            && request.resource.data.stats.last7 is list
            && request.resource.data.stats.last7.size() <= 7))
        && (request.resource.data.get('todayHabits', null) == null
          || (request.resource.data.todayHabits is list
            && request.resource.data.todayHabits.size() <= 12));

      // Skrzynka: przybicie piątki, zaproszenie, akceptacja, wyzwanie. Jeden dokument
      // na nadawcę (id = UID nadawcy), więc nikt nie zasypie skrzynki.
      match /cheers/{fromUid} {
        allow read: if isOwner(uid);
        allow delete: if isOwner(uid) || isOwner(fromUid);
        allow create, update: if isOwner(fromUid) && isMember() && fromUid != uid
          && request.resource.data.keys().hasOnly(['from', 'kind', 'name', 'at'])
          && request.resource.data.from == fromUid
          && request.resource.data.at == request.time
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 40
          && (
            (request.resource.data.kind in ['cheer', 'accept', 'challenge']
              && getAfter(friendshipPath(fromUid, uid)).data.status == 'accepted')
            || (request.resource.data.kind == 'request'
              && getAfter(friendshipPath(fromUid, uid)).data.status == 'pending'
              && getAfter(friendshipPath(fromUid, uid)).data.requestedBy == fromUid)
          )
          // Kolejna piątka najwcześniej po minucie
          && (resource == null || resource.data.kind != 'cheer'
            || request.time > resource.data.at + duration.value(60, 's'));
      }
    }

    // ------------------------------------------------------------------
    // Kod znajomego → UID (+ podgląd imienia i awatara do „Dodać Anię?”).
    // Można pobrać pojedynczy kod, ale nie da się ich wylistować.
    // ------------------------------------------------------------------
    match /friendCodes/{code} {
      allow get: if isMember();
      allow list: if false;
      allow create: if isMember()
        && code.matches('^[A-HJKMNP-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['uid', 'name', 'avatar', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && validPerson({ 'name': request.resource.data.name, 'avatar': request.resource.data.avatar });
      allow update: if isMember()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'avatar'])
        && validPerson({ 'name': request.resource.data.name, 'avatar': request.resource.data.avatar });
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ------------------------------------------------------------------
    // Znajomości: friendships/{uidA_uidB}
    // ------------------------------------------------------------------
    match /friendships/{pairId} {
      // Pojedynczy dokument po id (działa też, gdy jeszcze nie istnieje)
      allow get: if isSignedIn() && request.auth.uid in pairId.split('_');
      // Lista: tylko zapytanie where('members', 'array-contains', uid)
      allow list: if isSignedIn() && request.auth.uid in resource.data.members;

      allow create: if isMember()
        && request.resource.data.keys().hasOnly(
          ['members', 'requestedBy', 'status', 'createdAt', 'from', 'to'])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.members[0] < request.resource.data.members[1]
        && pairId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.requestedBy == request.auth.uid
        && request.auth.uid in request.resource.data.members
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && validPerson(request.resource.data.from)
        && validPerson(request.resource.data.to);

      // Akceptacja: tylko adresat, tylko pending → accepted, nic poza tym
      allow update: if isMember()
        && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.requestedBy
        && resource.data.status == 'pending'
        && request.resource.data.status == 'accepted'
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt']);

      // Odrzucenie / anulowanie / usunięcie znajomego — każda ze stron
      // (po id, więc usunięcie już nieistniejącej znajomości też przechodzi)
      allow delete: if isSignedIn() && request.auth.uid in pairId.split('_');
    }

    // ------------------------------------------------------------------
    // Wyzwania ze znajomymi: challenges/{id}
    // members = zaproszeni (łącznie z autorem), joined = ci, którzy dołączyli.
    // Każdy uczestnik zmienia wyłącznie własne wpisy: dołączenie, wyjście
    // i odhaczone dni (checkins.{uid}).
    // ------------------------------------------------------------------
    function canInvite(members, i) {
      return members.size() <= i || members[i] == request.auth.uid || isAcceptedFriend(members[i]);
    }

    // Lista po zmianie różni się co najwyżej moim UID
    function onlyMeChanged(before, after) {
      return after.removeAll([request.auth.uid]) == before.removeAll([request.auth.uid]);
    }

    match /challenges/{challengeId} {
      // Lista: tylko zapytanie where('members', 'array-contains', uid)
      allow read: if isSignedIn() && request.auth.uid in resource.data.members;

      allow create: if isMember()
        && request.resource.data.keys().hasOnly(
          ['title', 'icon', 'palette', 'days', 'start', 'createdBy', 'createdAt',
            'members', 'joined', 'people', 'checkins'])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 40
        && request.resource.data.icon is string
        && request.resource.data.icon.size() <= 40
        && request.resource.data.palette is string
        && request.resource.data.palette.size() <= 12
        && request.resource.data.days is int
        && request.resource.data.days >= 3
        && request.resource.data.days <= 30
        && request.resource.data.start is string
        && request.resource.data.start.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.members is list
        && request.resource.data.members.size() >= 2
        && request.resource.data.members.size() <= 5
        && request.resource.data.members.toSet().size() == request.resource.data.members.size()
        && request.resource.data.members[0] == request.auth.uid
        && canInvite(request.resource.data.members, 1)
        && canInvite(request.resource.data.members, 2)
        && canInvite(request.resource.data.members, 3)
        && canInvite(request.resource.data.members, 4)
        && request.resource.data.joined == [request.auth.uid]
        && request.resource.data.people is map
        && request.resource.data.people.keys().hasOnly(request.resource.data.members)
        && request.resource.data.checkins is map
        && request.resource.data.checkins.size() == 0;

      allow update: if isMember()
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'joined', 'people', 'checkins'])
        // members: bez zmian albo wychodzę
        && (request.resource.data.members == resource.data.members
          || request.resource.data.members == resource.data.members.removeAll([request.auth.uid]))
        // joined: dołączam na końcu listy albo wychodzę
        && onlyMeChanged(resource.data.joined, request.resource.data.joined)
        && (request.resource.data.joined == resource.data.joined
          || request.resource.data.joined == resource.data.joined.removeAll([request.auth.uid])
          || (!(request.auth.uid in resource.data.joined)
            && request.resource.data.joined == resource.data.joined.concat([request.auth.uid])))
        && request.resource.data.people.diff(resource.data.people).affectedKeys()
          .hasOnly([request.auth.uid])
        && request.resource.data.checkins.diff(resource.data.checkins).affectedKeys()
          .hasOnly([request.auth.uid])
        && (request.auth.uid in request.resource.data.members
          // Po wyjściu nie zostaje po mnie żaden ślad
          ? (!(request.auth.uid in request.resource.data.people)
            || request.resource.data.people[request.auth.uid] == resource.data.people[request.auth.uid])
          : (!(request.auth.uid in request.resource.data.joined)
            && !(request.auth.uid in request.resource.data.people)
            && !(request.auth.uid in request.resource.data.checkins)))
        // Odhaczać mogą tylko uczestnicy, którzy dołączyli
        && (!(request.auth.uid in request.resource.data.checkins)
          || (request.auth.uid in request.resource.data.joined
            && request.resource.data.checkins[request.auth.uid] is list
            && request.resource.data.checkins[request.auth.uid].size() <= resource.data.days));

      // Usunąć może autor albo ostatnia osoba w wyzwaniu
      allow delete: if isSignedIn()
        && (resource.data.createdBy == request.auth.uid
          || resource.data.members == [request.auth.uid]);
    }

    // Wszystko inne jest zamknięte
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
