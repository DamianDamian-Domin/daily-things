{
  "name": "daily-things",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "vite --mode emulator",
    "emulators": "npx -y firebase-tools@13 emulators:start --project demo-daily-things",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "preview": "vite preview",
    "android": "npm run build && node scripts/copy-android-res.mjs && npx cap sync",
    "icons": "npm i --no-save @material-symbols/svg-400 @resvg/resvg-js && node scripts/generate-pixel-icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.3",
    "@capacitor/cli": "^8.3.3",
    "@capacitor/core": "^8.3.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource-variable/lora": "^5.3.0",
    "@fontsource/sacramento": "^5.3.0",
    "@primeuix/themes": "^1.0.3",
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^11.9.1",
    "nanoid": "^5.1.5",
    "pinia": "^2.1.7",
    "primeicons": "^7.0.0",
    "primevue": "^4.3.3",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.4.21",
    "vue-router": "^4.3.0",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.8.3",
    "vite": "^8.3.4",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^2.2.12"
  }
}
